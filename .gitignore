# --- third-party tools: downloaded by install.ps1, never committed (licences don't allow redistribution) ---
tools/

# --- personal data: each user's own settings, apps and logs ---
command-center/settings.json
command-center/apps.json
command-center/icons/
command-center/*.log
command-center/.laptop-muted-by-cc
command-center/shot.png
command-center/themes/user-*.css
.playwright-mcp/

# --- tablet app build output + private signing key ---
tablet-app/build/
tablet-app/*.apk
tablet-app/*.idsig
tablet-app/*.keystore
tablet-app/restore.ps1

# --- promo reel workspace (contains personal screen recordings) ---
reel/

# --- python / editor noise ---
__pycache__/
*.pyc
.vscode/
.idea/
.claude/

command-center/web/vision/
command-center/study.json
command-center/vision.log
command-center/vision-debug.jpg
command-center/siren.wav
command-center/study-session.json
